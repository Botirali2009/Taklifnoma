# PostgreSQL (Neon / Railway / lokal)
DATABASE_URL="postgresql://user:password@localhost:5432/taklifnoma?schema=public"

# Migration yaratish uchun (faqat lokal, scripts/create-migration.sh)
SHADOW_DATABASE_URL="postgresql://user:password@localhost:5432/taklifnoma_shadow?schema=public"

# Sayt manzili — taklifnoma havolasi va QR kod shu asosda quriladi.
# NEXT_PUBLIC_* build vaqtida brauzer kodiga joylashadi; APP_URL esa
# server tomonda runtime'da o'qiladi (bot, QR, PDF havolalari uchun).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="uzun-tasodifiy-satr"   # openssl rand -base64 32

# Lokal test kirishi — Google/Telegram kalitlarisiz dashboard va adminni ko'rish.
# Faqat `npm run dev` da ishlaydi, production build'da e'tiborga olinmaydi.
ALLOW_DEV_LOGIN="true"

# Google OAuth (bo'lmasa Google tugmasi ko'rinmaydi)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Telegram Login Widget va bot (bo'lmasa Telegram tugmasi ko'rinmaydi)
TELEGRAM_BOT_TOKEN=""
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""
# Webhook himoyasi: setWebhook'dagi secret_token bilan bir xil bo'lsin
TELEGRAM_WEBHOOK_SECRET=""
# Lokal Bot API serveri yoki testlar uchun (odatda bo'sh)
# TELEGRAM_API_ROOT=""

# Cron (Vercel Cron) himoyasi — /api/cron/reminders
CRON_SECRET=""

